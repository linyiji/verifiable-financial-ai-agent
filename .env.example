# Copy to ignored .env.local. Never commit credentials.
# ADVANCED NATIVE ONLY — Docker evaluator setup generates its own local configuration.
# Native evaluator: encrypted Owner-issued .vfaeval + interactive session launcher.
# No evaluator bearer token belongs in any environment variable.
VFA_CREDENTIAL_MODE=evaluator
# Optional public HTTPS origin pin; otherwise use authenticated bundle URL.
VFA_EVALUATOR_GATEWAY_URL=
# DATABASE — provision this database first; URL-encode password special characters.
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@127.0.0.1:5432/verifiable_financial
ARTIFACT_ROOT=artifacts
WORKSPACE_ROOT=workspaces

# ADVANCED BYOK / OWNER GATEWAY ONLY — set VFA_CREDENTIAL_MODE=byok first.
# Leave all provider credentials EMPTY on evaluator machines.
FMP_API_KEY=
# Optional ordered key pool; fill contiguous entries only, or leave all empty.
FMP_API_KEY_1=
FMP_API_KEY_2=
FMP_API_KEY_3=
FMP_API_KEY_4=
FMP_BASE_URL=https://financialmodelingprep.com

# TEAMOROUTER — Owner/BYOK authority only.
TEAMOROUTER_API_KEY=
TEAMOROUTER_BASE_URL=https://api.teamorouter.com/v1
TEAMOROUTER_MODEL=gpt-5.6-sol
TEAMOROUTER_FALLBACK_MODEL=gpt-5.6-luna
LLM_PROVIDER=teamorouter
INCREMENTAL_PROVIDER_ROUTE=teamorouter-sol

# MIMO — required by the default Peer and Research News specialist routes.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_DATA_MODEL=mimo-v2.5
MIMO_CHAT_MODEL=mimo-v2.5
# Optional instead of the three direct-authority fields above:
# MIMO_AUTHORITY_FILE=/path/to/private/mimo.env
# If set, that file must contain MIMO_API_KEY, MIMO_BASE_URL, MIMO_CHAT_MODEL.
# Direct authority validates the official HTTPS endpoint and established model IDs.
SPECIALIST_PROVIDER_ROUTES={"peer_analysis":"mimo-direct","research_news_analysis":"mimo-direct"}
PLANNER_PREFERRED_PROVIDER=mimo
PLANNER_FALLBACK_PROVIDERS=teamorouter

# OBSERVABILITY — optional; omit to use the no-op trace adapter.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# FRONTEND — API default is already :8010.
# Export in the frontend shell for a non-default API; Vite does not load repo-root .env.local.
VITE_API_BASE_URL=http://127.0.0.1:8010
