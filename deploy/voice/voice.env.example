# Redacted operator template; all real secrets belong in private/ignored files only.
# VoiceSession duration is server-fixed: new calls 15 minutes, warning at minute 13.
# There is no extension or automatic renewal environment override.
VEFIN_VOICE_AUTH_MODE=disabled
VEFIN_VOICE_LOCAL_TOKENS={}
VEFIN_VOICE_LOCAL_TASK_GRANTS={}
VEFIN_VOICE_WORKER_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_DOMAIN=voice.example.com
VEFIN_ASR_PROVIDER=faster-whisper
VEFIN_ASR_MODEL=base
VEFIN_ASR_LANGUAGE=
VEFIN_TTS_PROVIDER=espeak
VEFIN_TTS_VOICE=cmn
# http TTS: OpenAI-compatible audio/speech, raw mono signed 16-bit PCM output.
VEFIN_TTS_URL=
VEFIN_TTS_API_KEY=
VEFIN_TTS_MODEL=
VEFIN_TTS_SAMPLE_RATE=24000
# Optional intent-only model. It cannot write Chat/Task/Run or supply progress claims.
VEFIN_VOICE_MODEL_PROVIDER=disabled
VEFIN_VOICE_MODEL_URL=
VEFIN_VOICE_MODEL_API_KEY=
VEFIN_VOICE_MODEL=
VEFIN_EVIDENCE_ROOT=/evidence

# Voice-only dialogue route, separate from research provider configuration.
DEEPSEEK_API_KEY=
VEFIN_VOICE_LLM_PROVIDER=deepseek_official
VEFIN_VOICE_LLM_BASE_URL=https://api.deepseek.com
VEFIN_VOICE_LLM_MODEL=deepseek-flash
VEFIN_VOICE_LLM_DEADLINE_SECONDS=5
VEFIN_VOICE_DIALOGUE_DEADLINE_SECONDS=8
# VEFIN_VOICE_PRIVATE_CONFIG_DIR selects operator-owned credential references.
