FROM python:3.11-slim
RUN pip install --no-cache-dir 'cryptography>=46,<47' 'alembic>=1.13,<2' \
    'aiosqlite>=0.20,<1' 'fastapi>=0.115,<1' 'httpx>=0.27,<1' \
    'pydantic>=2.9,<3' 'pydantic-settings>=2.5,<3' 'sqlalchemy[asyncio]>=2,<3' \
    'sse-starlette>=2.1,<3' 'uvicorn[standard]>=0.30,<1' \
    'pytest>=8.3,<9' 'pytest-asyncio>=1.2,<2' 'ruff>=0.8,<1' 'asyncpg>=0.30,<1'
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends git perl bash unzip \
    && apt-get clean
COPY --from=node:24-bookworm-slim /usr/local/bin/node /usr/local/bin/node
RUN pip install --no-cache-dir opentelemetry-sdk opentelemetry-exporter-otlp-proto-http
WORKDIR /work
ENV PYTHONPATH=/work PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "pytest"]
